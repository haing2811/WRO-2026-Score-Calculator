// State management
let currentCategory = 'elementary';
let scoringState = {};
let runHistory = (() => {
    try {
        const val = localStorage.getItem('wro-2026-history');
        return val ? JSON.parse(val) : [];
    } catch (e) {
        console.warn('Failed to parse history, resetting');
        localStorage.removeItem('wro-2026-history');
        return [];
    }
})();
let activeTab = localStorage.getItem('wro-2026-activeTab');
if (!activeTab) {
    activeTab = 'elementary';
}
let fieldImg = null; // To store the loaded field image
let fieldImgCache = {}; // Cache for preloaded field images
let overlayContainer = null; // Overlay container for color-coded boxes
let fieldCanvas = null;
let ctx = null;
let fieldWrapper = null;
let devicePixelRatio = window.devicePixelRatio || 1; // For high-DPI displays

// Helper to convert hex color to rgb string "r,g,b"
function hexToRgb(hex) {
    const shorthandRegex = /^#?([a-f\d])([a-f\d])([a-f\d])$/i;
    hex = hex.replace(shorthandRegex, (m, r, g, b) => r + r + g + g + b + b);
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    return result ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}` : null;
}

// Helper to convert hex color to rgba string "r,g,b,a"
function hexToRgba(hex, alpha = 1) {
    const rgb = hexToRgb(hex);
    if (!rgb) return `rgba(0,0,0,${alpha})`;
    return `rgba(${rgb},${alpha})`;
}

// Abbreviate label by taking first letter of each word
function abbreviateLabel(label) {
    return label.split(' ').map(word => word[0]).join('');
}

// Accidentally constant colors
const ACCENT_SUCCESS_RGB = hexToRgb('#4caf80'); // green
document.documentElement.style.setProperty('--accent-success-rgb', ACCENT_SUCCESS_RGB);

/**
 * Convert hex color string to "r,g,b" string.
 * @param {string} hex - e.g. "#ff0000" or "ff0000"
 * @returns {string} "r,g,b"
 */

// Field overlay zones (fraction-based, relative to actual field image dimensions)
// Each zone: { id, label, x, y, w, h } where x,y,w,h are fractions (0-1) of image width/height
const FIELD_OVERLAYS = {
    elementary: [],
    junior: [],
    senior: []
};

// Precompute FIELD_OVERLAYS for each category by converting pixel values from getRegionsForCategory to fractions
// Assumes the nominal image dimensions used in getRegionsForCategory are 600x400
function precomputeFieldOverlays() {
    for (const category in SCORING_DATA) {
        FIELD_OVERLAYS[category] = [];
        if (category === 'junior') {
            // Hardcoded overlay positions for Junior (percentages converted to fractions)
            const juniorOverlays = [
                { id: "j-visitor-red", label: "Visitor Red", x: 0.112, y: 0.90, w: 0.04, h: 0.06 },
                { id: "j-visitor-green", label: "Visitor Green", x: 0.161, y: 0.906, w: 0.038, h: 0.051 },
                { id: "j-visitor-blue", label: "Visitor Blue", x: 0.21, y: 0.906, w: 0.038, h: 0.051 },
                { id: "j-visitor-black", label: "Visitor Black", x: 0.258, y: 0.909, w: 0.038, h: 0.05 },
                { id: "j-red-tower-1", label: "Red Tower 1", x: 0.019, y: 0.143, w: 0.033, h: 0.081 },
                { id: "j-red-tower-2", label: "Red Tower 2", x: 0.018, y: 0.272, w: 0.035, h: 0.08 },
                { id: "j-yellow-tower-1", label: "Yellow Tower 1", x: 0.079, y: 0.021, w: 0.038, h: 0.108 },
                { id: "j-yellow-tower-2", label: "Yellow Tower 2", x: 0.141, y: 0.019, w: 0.035, h: 0.073 },
                { id: "j-artefact-1", label: "Artefact 1", x: 0.429, y: 0.898, w: 0.041, h: 0.086 },
                { id: "j-artefact-2", label: "Artefact 2", x: 0.484, y: 0.9, w: 0.041, h: 0.083 },
                { id: "j-artefact-3", label: "Artefact 3", x: 0.537, y: 0.9, w: 0.046, h: 0.083 },
                { id: "j-artefact-4", label: "Artefact 4", x: 0.594, y: 0.9, w: 0.042, h: 0.08 },
                { id: "j-barrier-white", label: "Barrier White", x: 0.82, y: 0.016, w: 0.119, h: 0.066 },
                { id: "j-barrier-red", label: "Barrier Red", x: 0.952, y: 0.376, w: 0.027, h: 0.244 },
                { id: "j-parrot", label: "Parrot", x: 0.798, y: 0.75, w: 0.031, h: 0.079 }
            ];
            FIELD_OVERLAYS[category] = juniorOverlays;
            continue;
        }
        const regions = getRegionsForCategory(category); // Returns array of {id, x, y, width, height, label} in pixels
        for (const region of regions) {
            // Convert to fractions: divide by nominal dimensions (600x400)
            const xFraction = region.x / 600;
            const yFraction = region.y / 400;
            const wFraction = region.width / 600;
            const hFraction = region.height / 400;
            FIELD_OVERLAYS[category].push({
                id: region.id,
                label: region.label,
                x: xFraction,
                y: yFraction,
                w: wFraction,
                h: hFraction
            });
        }
    }
}

// Store field drawing info for use in overlay drawing and hit-testing
let fieldDrawInfo = null; // { offsetX, offsetY, scale }

// Compute how the field image is drawn on the canvas (returns { offsetX, offsetY, scale })
function computeFieldDrawInfo() {
    if (!fieldImg) return null;
    const rect = fieldWrapper.getBoundingClientRect();
    const cssWidth = rect.width;
    const cssHeight = rect.height;
    const scaleX = cssWidth / fieldImg.width;
    const scaleY = cssHeight / fieldImg.height;
    const scale = Math.min(scaleX, scaleY);
    const offsetX = (cssWidth - fieldImg.width * scale) / 2;
    const offsetY = (cssHeight - fieldImg.height * scale) / 2;
    return { offsetX, offsetY, scale };
}

// Preload field images
function preloadFieldImages() {
    const categories = ['elementary', 'junior', 'senior'];
    categories.forEach(category => {
        const img = new Image();
        img.onload = () => {
            if (category === currentCategory) {
                fieldImg = img;
                drawField();
            }
        };
        img.onerror = () => {
            console.warn(`Failed to load field image for ${category}`);
            if (category === currentCategory) {
                fieldImg = null;
                drawField(); // Draw placeholder
            }
        };
        img.src = `GameField/${category.charAt(0).toUpperCase() + category.slice(1)}.png`;
        fieldImgCache[category] = img;
    });
}

// DOM Elements
let teamNameInput, roundNumberInput, timeSecondsInput;
let resetBtn, saveBtn;
let tabs, sidebar, liveTotal, scoreBreakdown, historyTable;

// Initialize the application
document.addEventListener('DOMContentLoaded', () => {
    try {
        initElements();
        preloadFieldImages(); // Preload images to avoid lag on tab switch
        precomputeFieldOverlays(); // Precompute field overlay zones
        resizeCanvas(); // Ensure correct initial sizing
        const stateLoaded = loadState();
        if (!stateLoaded) {
            // No saved state, set up based on stored activeTab preference
            setActiveTab(activeTab);
        }
        updateTabButtonsText();
        renderUI();
        updateLiveTotal();
        loadHistory();

        // Add zoom prevention
        document.addEventListener('wheel', (e) => {
            if (e.ctrlKey) e.preventDefault();
        }, { passive: false });

        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && ['+', '-', '=', '0'].includes(e.key)) e.preventDefault();
        });

        // Set up ResizeObserver for the field-wrapper
        const resizeObserver = new ResizeObserver(resizeCanvas);
        resizeObserver.observe(fieldWrapper);
        // Keep the window resize event as a fallback
        window.addEventListener('resize', resizeCanvas);
    } catch (error) {
        console.error('Failed to initialize application:', error);
        // Create and show an error banner
        const banner = document.createElement('div');
        banner.style.position = 'fixed';
        banner.style.top = '0';
        banner.style.left = '0';
        banner.style.width = '100%';
        banner.style.backgroundColor = '#ff4444';
        banner.style.color = 'white';
        banner.style.padding = '10px';
        banner.style.textAlign = 'center';
        banner.style.zIndex = '1000';
        banner.style.fontFamily = 'Arial, sans-serif';
        banner.innerHTML = `
            <strong>An error occurred while loading the application:</strong> ${error.message}<br>
            <button id="reload-btn" style="margin-top: 10px; padding: 5px 10px; background: white; color: #ff4444; border: none; border-radius: 4px; cursor: pointer;">Reload Page</button>
        `;
        document.body.insertBefore(banner, document.body.firstChild);
        document.getElementById('reload-btn').addEventListener('click', () => {
            location.reload();
        });
    }
});

// Initialize DOM elements
function initElements() {
    fieldCanvas = document.getElementById('field-canvas');
    ctx = fieldCanvas.getContext('2d');
    fieldWrapper = fieldCanvas.parentElement; // #field-wrapper
    overlayContainer = document.getElementById('overlay-container');

    teamNameInput = document.getElementById('team-name');
    roundNumberInput = document.getElementById('round-number');
    timeSecondsInput = document.getElementById('time-seconds');
    resetBtn = document.getElementById('btn-reset');
    saveBtn = document.getElementById('btn-save');
    tabs = document.getElementById('tabs');
    sidebar = document.getElementById('sidebar');
    liveTotal = document.getElementById('live-total');
    scoreBreakdown = document.getElementById('score-breakdown');
    historyTable = document.getElementById('history-table-body');

    // History modal elements
    const historyBtn = document.getElementById('btn-history');
    const historyModal = document.getElementById('history-modal');
    const historyCloseBtn = document.getElementById('btn-close-history');

    // Event listeners
    resetBtn.addEventListener('click', resetCurrentRun);
    saveBtn.addEventListener('click', saveCurrentRun);

    tabs.addEventListener('click', (e) => {
        if (e.target.classList.contains('tab-btn')) {
            const category = e.target.dataset.category;
            setActiveTab(category);
        }
    });

    // Canvas click handler for toggling regions
    fieldCanvas.addEventListener('click', (e) => {
        const rect = fieldCanvas.getBoundingClientRect();
        const canvasX = e.clientX - rect.left;
        const canvasY = e.clientY - rect.top;

        // Find which region was clicked
        const regionId = getZoneAtPosition(canvasX, canvasY);
        if (regionId) {
            toggleRegionState(regionId);
        }
    });

    // Sidebar click handler for scoring buttons and section toggles
    sidebar.addEventListener('click', (e) => {
        // Handle scoring button clicks
        if (e.target.classList.contains('btn-item')) {
            const itemId = e.target.dataset.id;
            const state = parseInt(e.target.dataset.state);
            setItemState(itemId, state); // This will update state, save, redraw overlay, and update live total
        }

        // Handle section header clicks for toggle (optional)
        if (e.target.classList.contains('section-header') ||
            e.target.parentElement.classList.contains('section-header')) {
            const sectionHeader = e.target.classList.contains('section-header')
                ? e.target
                : e.target.parentElement;
            const sectionContent = sectionHeader.nextElementSibling;
            if (sectionContent && sectionContent.classList.contains('section-content')) {
                sectionContent.classList.toggle('collapsed');
            }
        }
    });

    // Auto-save on input changes
    [teamNameInput, roundNumberInput, timeSecondsInput].forEach(input => {
        input.addEventListener('change', saveState);
    });

    // History modal controls
    historyBtn.addEventListener('click', () => {
        historyModal.classList.remove('hidden');
        historyModal.classList.add('show');
    });
    historyCloseBtn.addEventListener('click', () => {
        historyModal.classList.remove('show');
        historyModal.classList.add('hidden');
    });
    // Clicking outside the modal content closes it
    historyModal.addEventListener('click', (e) => {
        if (e.target === historyModal) {
            historyModal.classList.remove('show');
            historyModal.classList.add('hidden');
        }
    });
}

/**
 * Update tab button texts to show "{Category} — {Subtitle}".
 */
function updateTabButtonsText() {
    document.querySelectorAll('.tab-btn').forEach(btn => {
        const category = btn.dataset.category;
        const data = SCORING_DATA[category];
        btn.textContent = `${data.name} — ${data.subtitle}`;
    });
}

// Initialize canvas
function initCanvas() {
    resizeCanvas();
    drawField();
}

// Resize canvas to fit the field-wrapper'maintaining aspect ratio
// Account for device pixel ratio for sharp rendering on high-DPI screens
function resizeCanvas() {
    if (!fieldWrapper) return;
    const rect = fieldWrapper.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    fieldCanvas.width = Math.round(rect.width * dpr);
    fieldCanvas.height = Math.round(rect.height * dpr);
    fieldCanvas.style.width = rect.width + 'px';
    fieldCanvas.style.height = rect.height + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); // reset and scale
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    drawField();
}

// Load the field image for current category (from cache)
function loadFieldImage() {
    return new Promise((resolve, reject) => {
        let img = fieldImgCache[currentCategory];
        if (!img) {
            img = new Image();
            fieldImgCache[currentCategory] = img;
        }
        if (img.complete) {
            fieldImg = img;
            drawField();
            return resolve();
        }
        img.onload = () => {
            fieldImg = img;
            drawField();
            resolve();
        };
        img.onerror = () => {
            console.warn(`Failed to load field image for ${currentCategory}`);
            fieldImg = null;
            drawField(); // draw placeholder
            resolve();
        };
        img.src = `GameField/${currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1)}.png`;
    });
}

// Draw the field with the image (centered, maintaining aspect ratio)
function drawField() {
    // Clear the entire bitmap
    ctx.clearRect(0, 0, fieldCanvas.width, fieldCanvas.height);

    // Fill background
    ctx.fillStyle = '#141414'; // Field map panel background
    ctx.fillRect(0, 0, fieldCanvas.width, fieldCanvas.height);

    const rect = fieldWrapper.getBoundingClientRect();
    const cssWidth = rect.width;
    const cssHeight = rect.height;

    if (fieldImg) {
        // Compute and store how the image is drawn
        fieldDrawInfo = computeFieldDrawInfo();
        const { offsetX, offsetY, scale } = fieldDrawInfo;
        const drawWidth = fieldImg.width * scale;
        const drawHeight = fieldImg.height * scale;

        ctx.drawImage(fieldImg, offsetX, offsetY, drawWidth, drawHeight);

        // Redraw overlays after drawing the image
        syncOverlayState();
    } else {
        // Draw placeholder if image fails
        ctx.fillStyle = '#1a1a1a'; // Card background
        ctx.fillRect(0, 0, fieldCanvas.width, fieldCanvas.height);
        ctx.strokeStyle = '#2a2a2a';
        ctx.lineWidth = 2;
        ctx.strokeRect(0, 0, fieldCanvas.width, fieldCanvas.height);

        ctx.fillStyle = '#f2f2f2';
        ctx.font = 'bold 20px Inter';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(`${SCORING_DATA[currentCategory].name} Field`,
                     cssWidth / 2,
                     cssHeight / 2);
    }
}

// Get regions for current category (using coordinates from handoff document SVG viewBox 0 0 600 400)
function getRegionsForCategory(category) {
    // These coordinates are from the handoff document SVG viewBox 0 0 600 400
    const regionsMap = {
        elementary: [
            // Section 1 - Connect the amplifier
            { id: 'e-cable-1', x: 72, y: 14, width: 24, height: 50, label: 'Cable 1' },
            { id: 'e-cable-2', x: 72, y: 330, width: 24, height: 50, label: 'Cable 2' },

            // Section 2 - Prepare the show
            { id: 'e-mic', x: 190, y: 120, width: 26, height: 30, label: 'Mic' },
            { id: 'e-guitar', x: 12, y: 162, width: 34, height: 50, label: 'Guitar' },
            { id: 'e-keyboard', x: 12, y: 200, width: 34, height: 50, label: 'Keyboard' },
            { id: 'e-congas', x: 12, y: 274, width: 34, height: 50, label: 'Congas' },

            // Section 3 - Play the song (notes)
            { id: 'e-note-red', x: 380, y: 62, width: 30, height: 36, label: 'R' },
            { id: 'e-note-blue', x: 418, y: 62, width: 30, height: 36, label: 'B' },
            { id: 'e-note-green', x: 456, y: 62, width: 30, height: 36, label: 'G' },
            { id: 'e-note-yellow', x: 380, y: 112, width: 30, height: 36, label: 'Y' },
            { id: 'e-note-white', x: 418, y: 112, width: 30, height: 36, label: 'W' },
            { id: 'e-note-black', x: 456, y: 112, width: 30, height: 36, label: 'Bl' },

            // Section 4 - Bonus points
            { id: 'e-clef', x: 340, y: 82, width: 24, height: 28, label: 'Clef' },
            { id: 'e-speaker-1', x: 160, y: 62, width: 34, height: 40, label: 'Speaker 1' },
            { id: 'e-speaker-2', x: 160, y: 300, width: 34, height: 40, label: 'Speaker 2' },
            { id: 'e-amp', x: 100, y: 120, width: 36, height: 50, label: 'Amplifier' }
        ],
        junior: [
            // Section 1 - Visitors (bottom-left)
            { id: 'j-visitor-green', x: 16, y: 310, width: 32, height: 40, label: 'VG' },
            { id: 'j-visitor-red', x: 56, y: 310, width: 32, height: 40, label: 'VR' },
            { id: 'j-visitor-black', x: 96, y: 310, width: 32, height: 40, label: 'VB' },
            { id: 'j-visitor-blue', x: 136, y: 310, width: 32, height: 40, label: 'VB' },

            // Section 2 - Rebuild the towers
            { id: 'j-red-tower-1', x: 30, y: 16, width: 36, height: 44, label: 'RT1' },
            { id: 'j-red-tower-2', x: 76, y: 16, width: 36, height: 44, label: 'RT2' },
            { id: 'j-yellow-tower-1', x: 130, y: 16, width: 36, height: 44, label: 'YT1' },
            { id: 'j-yellow-tower-2', x: 130, y: 70, width: 36, height: 44, label: 'YT2' },

            // Section 3 - Artefacts (museum zone, top-right)
            { id: 'j-artefact-1', x: 430, y: 18, width: 30, height: 40, label: 'A1' },
            { id: 'j-artefact-2', x: 470, y: 18, width: 30, height: 40, label: 'A2' },
            { id: 'j-artefact-3', x: 510, y: 18, width: 30, height: 40, label: 'A3' },
            { id: 'j-artefact-4', x: 550, y: 18, width: 30, height: 40, label: 'A4' },

            // Section 5 - Bonus
            { id: 'j-barrier-red', x: 448, y: 210, width: 30, height: 32, label: 'BR' },
            { id: 'j-barrier-white', x: 492, y: 210, width: 30, height: 32, label: 'BW' },
            { id: 'j-parrot', x: 536, y: 210, width: 28, height: 32, label: 'Par' }
        ],
        senior: [
            // Section 1 - Provide tools
            { id: 's-tellel-rect', x: 160, y: 300, width: 40, height: 44, label: 'TR' },
            { id: 's-cement-bowl', x: 280, y: 310, width: 40, height: 40, label: 'CB' },
            { id: 's-trowel-mason', x: 420, y: 300, width: 40, height: 44, label: 'MT' },

            // Section 2 - Mosaic (4x3 grid)
            ...Array.from({length: 12}, (_, i) => {
                const col = i % 4;
                const row = Math.floor(i / 4);
                const x = 130 + col * 48;
                const y = 50 + row * 52;
                return {
                    id: `s-mosaic-${i + 1}`,
                    x: x,
                    y: y,
                    width: 40,
                    height: 44,
                    label: `M${i + 1}`
                };
            }),

            // Section 4 - Bonus barriers
            { id: 's-barrier-red1', x: 340, y: 100, width: 30, height: 28, label: 'BR1' },
            { id: 's-barrier-red2', x: 380, y: 100, width: 30, height: 28, label: 'BR2' },
            { id: 's-barrier-black1', x: 420, y: 100, width: 30, height: 28, label: 'BB1' },
            { id: 's-barrier-black2', x: 460, y: 100, width: 30, height: 28, label: 'BB2' }
        ]
    };

    return regionsMap[category] || [];
}

// Get region ID at canvas position
function getRegionAtPosition(canvasX, canvasY) {
    const regions = getRegionsForCategory(currentCategory);

    for (const region of regions) {
        if (!fieldImg) continue;

        // Convert canvas coordinates to CSS pixels (accounting for DPR)
        const cssX = canvasX / devicePixelRatio;
        const cssY = canvasY / devicePixelRatio;

        const scaleX = (fieldCanvas.width / devicePixelRatio) / fieldImg.width;
        const scaleY = (fieldCanvas.height / devicePixelRatio) / fieldImg.height;
        const scale = Math.min(scaleX, scaleY);
        const offsetX = ((fieldCanvas.width / devicePixelRatio) - fieldImg.width * scale) / 2;
        const offsetY = ((fieldCanvas.height / devicePixelRatio) - fieldImg.height * scale) / 2;

        const regionCanvasX = (region.x * scale) + offsetX;
        const regionCanvasY = (region.y * scale) + offsetY;
        const regionCanvasWidth = region.width * scale;
        const regionCanvasHeight = region.height * scale;

        if (cssX >= regionCanvasX &&
            cssX <= regionCanvasX + regionCanvasWidth &&
            cssY >= regionCanvasY &&
            cssY <= regionCanvasY + regionCanvasHeight) {
            return region.id;
        }
    }

    return null;
}

// Get item by ID
function getItemById(id) {
    const categoryData = SCORING_DATA[currentCategory];
    for (const section of categoryData.sections) {
        for (const item of section.items) {
            if (item.id === id) return item;
        }
    }
    return null;
}

// Set active tab
function setActiveTab(category) {
    currentCategory = category;
    localStorage.setItem('wro-2026-activeTab', category);

    // Update tab buttons
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.category === category);
    });

    // Update header accent color
    const accentHex = SCORING_DATA[category].accentColor;
    const accentRgb = hexToRgb(accentHex);
    document.documentElement.style.setProperty('--accent-primary', accentHex);
    document.documentElement.style.setProperty('--accent-primary-rgb', accentRgb);

    // Update field header
    const fieldHeader = document.querySelector('#canvas-container .field-header');
    if (fieldHeader) {
        fieldHeader.textContent = `FIELD MAP — ${SCORING_DATA[category].name}`;
    }

    // Load state for this category (team name, round, time, scoringState)
    const stateLoaded = loadStateForCategory(category);
    if (!stateLoaded) {
        // No saved state for this category: initialize scoring state to zeros, keep current input values
        setScoringStateForCategory(category);
    }

    // Render UI immediately (sidebar, etc.)
    renderUI();
    updateLiveTotal();

    // Reload field image (from cache) and then draw overlay
    loadFieldImage().then(() => {
        // Redraw overlay for the new category
        syncOverlayState();
        // Update total in case any scoring changed (should not)
        updateLiveTotal();
    });

    // Update tab buttons text (in case subtitle changed, though it doesn't)
    updateTabButtonsText();
}

// Render the entire UI
function renderUI() {
    renderScoringSidebar();
    updateLiveTotal();
}

// Render scoring sidebar
function renderScoringSidebar() {
    sidebar.innerHTML = '';
    const categoryData = SCORING_DATA[currentCategory];

    // Create header with category name
    const header = document.createElement('div');
    header.className = 'sidebar-header';
    header.innerHTML = `
        <h2>${categoryData.name}</h2>
        <div class="header-actions">
            <div class="max-score">Max Score: ${categoryData.maxScore}</div>
            <button id="btn-clear-scores" class="btn-danger">Clear Scores</button>
        </div>
    `;
    sidebar.appendChild(header);

    // Add event listener for the clear scores button
    const clearBtn = header.querySelector('#btn-clear-scores');
    clearBtn.addEventListener('click', clearScores);

    // Render each section
    categoryData.sections.forEach(section => {
        const sectionEl = document.createElement('div');
        sectionEl.className = 'section-card';
        sectionEl.innerHTML = `
            <div class="section-header" data-section-id="${section.id}">
                <h3>${section.title}</h3>
                <div class="section-status">not yet scored</div>
                <div class="section-score">0 / ${section.maxPoints}</div>
            </div>
            <div class="section-content">
                <!-- Items will be populated here -->
            </div>
        `;

        const contentDiv = sectionEl.querySelector('.section-content');
        section.items.forEach(item => {
            const itemEl = document.createElement('div');
            itemEl.className = 'item-row';

            // Create label first (full name, not abbreviated)
            const labelSpan = document.createElement('span');
            labelSpan.className = 'item-label';
            labelSpan.textContent = item.label;

            // Create controls container
            const controlsDiv = document.createElement('div');
            controlsDiv.className = 'item-controls';
            // Set flex wrap and gap for spacing
            controlsDiv.style.display = 'flex';
            controlsDiv.style.gap = '16px'; // increased spacing
            controlsDiv.style.alignItems = 'center';
            controlsDiv.style.flexWrap = 'wrap';
            // Set background color based on state (will update later)
            // We'll set a class or inline style later

            
            // Check if this item is a group counter (has count property)
            if (item.count !== undefined) {
                // Slider implementation
                const slider = document.createElement('input');
                slider.type = 'range';
                slider.min = '0';
                slider.max = (item.options.length - 1).toString();
                slider.step = '1';
                slider.value = (scoringState[item.id] !== undefined ? scoringState[item.id] : 0).toString();
                slider.className = 'dirt-slider';
                slider.dataset.id = item.id;
                slider.style.flex = '1';
                slider.style.minWidth = '220px'; // Increased slider length
                slider.style.setProperty('--progress-width', '0%'); // No color outline/progress fill
                slider.style.backgroundColor = 'transparent'; // White appearance (will be styled by CSS)

                // Determine if this is the dirt special case (likely the only slider in Junior tab)
                const isDirtSlider = item.label === 'Dirt' || item.id === 'dirt' ||
                                   (item.options && item.options.length > 5 &&
                                    item.options[0] === 0 && item.options[1] === 2 &&
                                    item.options[item.options.length-1] >= 20);

                // Create value readout (current points) using .score-number class
                const valueLabel = document.createElement('span');
                valueLabel.className = 'score-number';
                valueLabel.style.fontSize = '14px';
                valueLabel.style.fontWeight = '600';
                valueLabel.style.minWidth = '60px';
                valueLabel.style.textAlign = 'center';
                valueLabel.style.marginLeft = '12px'; // Space between slider and value label

                if (isDirtSlider) {
                    // Update function for slider
                    const updateDisplay = () => {
                        const val = parseInt(slider.value);
                        const points = item.options[val];
                        valueLabel.textContent = `${points} pts`;
                        // Update valueLabel background based on state
                        let valueLabelBg = 'var(--bg-card)'; // default
                        if (val === 0) {
                            // none
                            valueLabelBg = 'rgba(255,255,255,0.12)';
                        } else if (val >= 2 && val <= 10) {
                            // partial
                            valueLabelBg = 'rgba(232,130,60,0.40)';
                        } else if (val >= 12) {
                            // full
                            valueLabelBg = 'rgba(76,175,128,0.40)';
                        }
                        valueLabel.style.backgroundColor = valueLabelBg;
                    };

                    const syncFromSlider = () => {
                        setItemState(item.id, parseInt(slider.value));
                        updateDisplay();
                    };
                    slider.addEventListener('input', syncFromSlider);
                    // Initialize
                    updateDisplay();

                    // Add elements to controlsDiv in order: [slider] [value-readout]
                    // (Removed min-label and max-label as requested)
                    controlsDiv.appendChild(slider);
                    controlsDiv.appendChild(valueLabel);
                } else {
                    // Button group
                    item.options.forEach((option, index) => {
                        const btn = document.createElement('button');
                        btn.className = `btn-item btn-${index === 0 ? 'none' : index === item.options.length - 1 ? 'full' : 'partial'}`;
                        btn.dataset.id = item.id;
                        btn.dataset.state = index;
                        btn.textContent = index === 0 ? '✕ None' :
                                         index === item.options.length - 1 ? `✓ ${option} pts` :
                                                                         `◐ ${option} pts`;
                        // Initial state will be set later via syncButtonState
                        controlsDiv.appendChild(btn);
                    });
                }
            }

            // Append label and controls to itemEl (label first, then controls)
            itemEl.appendChild(labelSpan);
            itemEl.appendChild(controlsDiv);

            // Append item to contentDiv
            contentDiv.appendChild(itemEl);
        });

        // Add event listener to section header for toggle (optional)
        sectionEl.querySelector('.section-header').addEventListener('click', () => {
            const content = sectionEl.querySelector('.section-content');
            content.classList.toggle('collapsed');
        });

        sidebar.appendChild(sectionEl);
    });

    // Sync button states after building the sidebar
    syncAllButtonStates();
}

// Update live total display
function updateLiveTotal() {
    let totalScore = 0;
    let maxScore = SCORING_DATA[currentCategory].maxScore;

    // Calculate score from scoringState
    for (const [itemId, state] of Object.entries(scoringState)) {
        const item = getItemById(itemId);
        if (item && item.options && item.options[state] !== undefined) {
            totalScore += item.options[state];
        }
    }

    // Update the total score display
    const totalScoreEl = document.getElementById('total-score');
    totalScoreEl.textContent = `${totalScore} / ${maxScore}`;

    // Update section scores
    updateSectionScores();
}

// Update individual section scores
function updateSectionScores() {
    const categoryData = SCORING_DATA[currentCategory];
    const sectionElements = document.querySelectorAll('.section-card');

    sectionElements.forEach((sectionEl, sectionIndex) => {
        const section = categoryData.sections[sectionIndex];
        let sectionScore = 0;

        // Calculate score for this section
        section.items.forEach(item => {
            const state = scoringState[item.id];
            if (state !== undefined && item.options && item.options[state] !== undefined) {
                sectionScore += item.options[state];
            }
        });

        // Update section score display
        const scoreEl = sectionEl.querySelector('.section-score');
        scoreEl.textContent = `${sectionScore} / ${section.maxPoints}`;

        // Update section status text and classes
        const statusEl = sectionEl.querySelector('.section-status');
        statusEl.textContent = sectionScore === 0 ? 'Not Yet Scored' :
                               sectionScore === section.maxPoints ? 'Fully Scored' :
                               'Partially Scored';
        // Reset classes to base then add state-specific class if needed
        statusEl.className = 'section-status';
        if (sectionScore !== 0 && sectionScore !== section.maxPoints) {
            statusEl.classList.add('partial');
        } else if (sectionScore === section.maxPoints) {
            statusEl.classList.add('full');
        }
        // Note: when score is 0, we keep only the base class (italic, muted)
    });
}

// Save state to localStorage
function saveState() {
    const stateData = {
        category: currentCategory,
        scoringState: scoringState,
        teamName: teamNameInput.value,
        roundNumber: roundNumberInput.value,
        timeSeconds: timeSecondsInput.value
    };
    localStorage.setItem(`wro-2026-state-${currentCategory}`, JSON.stringify(stateData));
}

// Load state from localStorage
// Returns true if state was loaded, false otherwise
function loadState() {
    const stateData = localStorage.getItem(`wro-2026-state-${currentCategory}`);
    if (stateData) {
        try {
            const parsed = JSON.parse(stateData);
            currentCategory = parsed.category || currentCategory;
            scoringState = parsed.scoringState || {};
            teamNameInput.value = parsed.teamName || '';
            roundNumberInput.value = parsed.roundNumber || '1';
            timeSecondsInput.value = parsed.timeSeconds || '0';

            // Ensure active tab matches
            setActiveTab(currentCategory);
            return true;
        } catch (e) {
            console.warn('Failed to parse state for', currentCategory, e);
            localStorage.removeItem(`wro-2026-state-${currentCategory}`);
            // fall through to init
        }
    }
    initScoringState();
    return false;
}

// Load state for a specific category (without changing activeTab storage)
function loadStateForCategory(category) {
    const stateData = localStorage.getItem(`wro-2026-state-${category}`);
    if (stateData) {
        try {
            const parsed = JSON.parse(stateData);
            scoringState = parsed.scoringState || {};
            teamNameInput.value = parsed.teamName || '';
            roundNumberInput.value = parsed.roundNumber || '1';
            timeSecondsInput.value = parsed.timeSeconds || '0';
            return true;
        } catch (e) {
            console.warn('Failed to parse state for', category, e);
            localStorage.removeItem(`wro-2026-state-${category}`);
            // fall through to return false
        }
    }
    return false;
}

// Set scoring state to all zeros for a given category (does not affect input fields)
function setScoringStateForCategory(category) {
    scoringState = {};
    const categoryData = SCORING_DATA[category];
    categoryData.sections.forEach(section => {
        section.items.forEach(item => {
            scoringState[item.id] = item.default !== undefined ? item.default : 0;
        });
    });
}

// Initialize scoring state for current category
function initScoringState() {
    scoringState = {};
    const categoryData = SCORING_DATA[currentCategory];
    categoryData.sections.forEach(section => {
        section.items.forEach(item => {
            scoringState[item.id] = item.default !== undefined ? item.default : 0;
        });
    });
}

// Sync button active state based on scoringState
function syncButtonState(itemId) {
    const item = getItemById(itemId);
    if (!item) return;
    const state = scoringState[itemId] !== undefined ? scoringState[itemId] : 0;
    // If this item is a slider (has count), update the slider and value readout
    if (item.count !== undefined) {
        const slider = document.querySelector(`input[type=range][data-id="${itemId}"]`);
        if (slider) {
            slider.value = state;
            // Update value readout (the span after the slider, skipping min-label)
            const valueLabel = slider.nextElementSibling.nextElementSibling; // Skip min-label
            if (valueLabel) {
                const points = item.options[state]; // Get actual points from options array
                valueLabel.textContent = `${points} pts`;
                // Update valueLabel background based on state
                let valueLabelBg = 'var(--bg-card)'; // default
                if (state === 0) {
                    // none
                    valueLabelBg = 'rgba(255,255,255,0.12)';
                } else if (state >= 2 && state <= 10) {
                    // partial
                    valueLabelBg = 'rgba(232,130,60,0.40)';
                } else if (state >= 12) {
                    // full
                    valueLabelBg = 'rgba(76,175,128,0.40)';
                }
                valueLabel.style.backgroundColor = valueLabelBg;
                // Ensure slider shows no progress fill
                slider.style.setProperty('--progress-width', '0%');
            }
        }
        // Update control background color for slider
        // Fall through to update overlay box
    } else {
        // Button group
        const btn = document.querySelector(`[data-id="${itemId}"]`);
        if (btn) {
            const group = btn.parentElement;
            // Determine type: none, partial, full based on options length
            const maxIndex = item.options.length - 1;
            let type;
            if (item.options.length === 2) {
                type = state === 0 ? 'none' : 'full';
            } else {
                // length 3 (or more, but we assume 3)
                type = state === 0 ? 'none' : (state === maxIndex ? 'full' : 'partial');
            }
            group.querySelectorAll('.btn-item').forEach(b => {
                b.classList.remove('active-none', 'active-partial', 'active-full');
                if (b.dataset.state == state.toString()) {
                    b.classList.add(`active-${type}`);
                    // Set background color for active button based on state
                    let buttonBg = 'var(--bg-card)'; // default
                    if (state === 0) {
                        // none
                        buttonBg = 'rgba(255,255,255,0.12)';
                    } else if (state === maxIndex) {
                        // full
                        buttonBg = 'rgba(76,175,128,0.40)';
                    } else {
                        // partial
                        buttonBg = 'rgba(232,130,60,0.40)';
                    }
                    b.style.backgroundColor = buttonBg;
                } else {
                    // Reset background color for inactive buttons
                    b.style.backgroundColor = 'transparent';
                }
            });
        // If no button found (should not happen for button groups), still update overlay
    }
    // Update overlay box for this item
    updateOverlayBox(itemId);
}

// Helper to compute background color for controls based on item state
function getControlBackgroundColor(item, state) {
    // state is numeric (0 for none, etc.)
    let bgColor = 'rgba(255,255,255,0.12)'; // none - white semi-transparent
    if (item.count !== undefined) {
        // slider item
        if (state >= 2 && state <= 10) {
            bgColor = 'rgba(232,130,60,0.40)'; // partial orange
        } else if (state >= 12) {
            bgColor = 'rgba(76,175,128,0.40)'; // full green
        }
    } else {
        // button group item
        const maxIndex = item.options.length - 1;
        if (item.options.length === 2) {
            if (state === 0) {
                bgColor = 'rgba(255,255,255,0.12)'; // none
            } else {
                bgColor = 'rgba(76,175,128,0.40)'; // full
            }
        } else {
            // assume 3 options
            if (state === 0) {
                bgColor = 'rgba(255,255,255,0.12)'; // none
            } else if (state === maxIndex) {
                bgColor = 'rgba(76,175,128,0.40)'; // full
            } else {
                bgColor = 'rgba(232,130,60,0.40)'; // partial
            }
        }
    }
    return bgColor;
}

// Sync all button states for the current category
function syncAllButtonStates() {
    const categoryData = SCORING_DATA[currentCategory];
    categoryData.sections.forEach(section => {
        section.items.forEach(item => {
            syncButtonState(item.id);
        });
    });
}

// Set item state and update UI
function setItemState(itemId, newState) {
    scoringState[itemId] = newState;
    saveState();
    syncOverlayState();
    syncButtonState(itemId);
    updateLiveTotal();
}

// Helper to draw rounded rectangle
function drawRoundedRect(ctx, x, y, width, height, radius, fillColor, strokeColor, lineWidth) {
    if (typeof ctx.roundRect === 'function') {
        ctx.roundRect(x, y, width, height, radius);
    } else {
        // Manual path for rounded rectangle
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.lineTo(x + width - radius, y);
        ctx.arcTo(x + width, y, x + width, y + height, radius);
        ctx.arcTo(x + width, y + height, x, y + height, radius);
        ctx.arcTo(x, y + height, x, y, radius);
        ctx.arcTo(x, y, x + radius, y, radius);
        ctx.closePath();
    }
    ctx.fillStyle = fillColor;
    ctx.fill();
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = lineWidth;
    ctx.stroke();
}

// Redraw the overlay (now using DOM elements)
function syncOverlayState() {
    // Update all overlay boxes to match current state
    updateAllOverlayBoxes();
}

// Get zone ID at canvas position (bitmap coordinates)
function getZoneAtPosition(canvasX, canvasY) {
    if (!fieldImg || !fieldDrawInfo) return null;
    const { offsetX, offsetY, scale } = fieldDrawInfo;
    const zones = FIELD_OVERLAYS[currentCategory];
    if (!zones) return null;

    // Convert canvas coordinates to bitmap coordinates
    const bitmapX = canvasX;
    const bitmapY = canvasY;

    for (const zone of zones) {
        // Convert zone's fractional image coordinates to bitmap pixels
        const imgPx = zone.x * fieldImg.width;
        const imgPy = zone.y * fieldImg.height;
        const imgPw = zone.w * fieldImg.width;
        const imgPh = zone.h * fieldImg.height;

        const bitmapPx = offsetX + imgPx * scale;
        const bitmapPy = offsetY + imgPy * scale;
        const bitmapPw = imgPw * scale;
        const bitmapPh = imgPh * scale;

        if (bitmapX >= bitmapPx &&
            bitmapX <= bitmapPx + bitmapPw &&
            bitmapY >= bitmapPy &&
            bitmapY <= bitmapPy + bitmapPh) {
            return zone.id;
        }
    }
    return null;
}

// Toggle zone state (None -> Partial -> Full -> None)
function toggleRegionState(zoneId) {
    const item = getItemById(zoneId);
    if (!item) return;
    const currentState = scoringState[zoneId] || 0;
    const nextState = (currentState + 1) % (item.options.length);
    setItemState(zoneId, nextState);
}

// Helper to get the overlay state class for an itemId
function getOverlayStateClass(itemId) {
    const item = getItemById(itemId);
    if (!item) return 'overlay-none'; // default if item not found
    const state = scoringState[itemId] || 0;
    const maxIndex = item.options.length - 1;
    if (state === 0) return 'overlay-none';
    if (state === maxIndex) return 'overlay-full';
    return 'overlay-partial';
}

function updateAllOverlayBoxes() {
    if (!overlayContainer) return;
    // Clear the container
    overlayContainer.innerHTML = '';

    // Guard: if no field image or draw info, we can't position boxes
    if (!fieldImg || !fieldDrawInfo) return;

    const zones = FIELD_OVERLAYS[currentCategory];
    if (!zones) return;

    zones.forEach(zone => {
        // Compute the box in CSS pixels (same as in getZoneAtPosition)
        const { offsetX, offsetY, scale } = fieldDrawInfo;
        const imgPx = zone.x * fieldImg.width;
        const imgPy = zone.y * fieldImg.height;
        const imgPw = zone.w * fieldImg.width;
        const imgPh = zone.h * fieldImg.height;

        const boxLeft = offsetX + imgPx * scale;
        const boxTop = offsetY + imgPy * scale;
        const boxWidth = imgPw * scale;
        const boxHeight = imgPh * scale;

        // Create the box div
        const box = document.createElement('div');
        box.className = 'overlay-box';
        box.dataset.itemId = zone.id;

        // Set position and size
        box.style.left = `${boxLeft}px`;
        box.style.top = `${boxTop}px`;
        box.style.width = `${boxWidth}px`;
        box.style.height = `${boxHeight}px`;

        // Add the label
        const label = document.createElement('span');
        label.className = 'overlay-label';
        label.textContent = zone.label;
        box.appendChild(label);

        // Determine and set the state class
        const stateClass = getOverlayStateClass(zone.id);
        box.classList.add(stateClass);

        // Add click handler to toggle the zone state
        box.addEventListener('click', () => {
            toggleRegionState(zone.id);
        });

        // Append to container
        overlayContainer.appendChild(box);
    });
}

function updateOverlayBox(itemId) {
    // If we don't have the container or the field image, we can't update
    if (!overlayContainer || !fieldImg || !fieldDrawInfo) return;

    // Find the box for this itemId
    const box = overlayContainer.querySelector(`[data-item-id="${itemId}"]`);
    if (!box) return; // Do nothing if box not found (might not be a field zone)

    // Remove any existing state classes
    box.classList.remove('overlay-none', 'overlay-partial', 'overlay-full');

    // Add the appropriate state class
    const stateClass = getOverlayStateClass(itemId);
    box.classList.add(stateClass);
}

// Load history from localStorage
// Calculate total score for the current category from scoringState
function calculateTotalScore() {
    let totalScore = 0;
    for (const [itemId, state] of Object.entries(scoringState)) {
        const item = getItemById(itemId);
        if (item && item.options && item.options[state] !== undefined) {
            totalScore += item.options[state];
        }
    }
    return totalScore;
}

// Clear Scores button — resets only the scoring selections for the current category
// back to "None", leaving Team/Round/Time untouched.
function clearScores() {
    if (!confirm('Clear all scoring selections for this category?')) return;
    setScoringStateForCategory(currentCategory);
    saveState();
    renderUI();
    updateLiveTotal();
    syncAllButtonStates();
    updateAllOverlayBoxes();
}

// Reset button — clears Team/Round/Time fields only, leaving current scoring selections
// untouched (distinct from Clear Scores, which only clears scoring).
function resetCurrentRun() {
    if (!confirm('Reset Team, Round, and Time fields for this run?')) return;
    teamNameInput.value = '';
    roundNumberInput.value = '1';
    timeSecondsInput.value = '0';
    saveState();
}

// Save Run button — records the current score as a new entry in Run History.
function saveCurrentRun() {
    const totalScore = calculateTotalScore();
    const entry = {
        id: Date.now() + '-' + Math.random().toString(36).substring(2, 9),
        team: teamNameInput.value || '(no team name)',
        round: roundNumberInput.value || '1',
        score: `${totalScore} / ${SCORING_DATA[currentCategory].maxScore}`,
        time: timeSecondsInput.value || '0',
        timestamp: new Date().toISOString()
    };
    runHistory.push(entry);
    localStorage.setItem('wro-2026-history', JSON.stringify(runHistory));
    loadHistory();
}

function loadHistory() {
    historyTable.innerHTML = '';
    const historyRaw = localStorage.getItem('wro-2026-history');
    let history = [];
    let needsSave = false;
    if (historyRaw) {
        try {
            history = JSON.parse(historyRaw);
            // Ensure each entry has an id
            history.forEach(entry => {
                if (!entry.id) {
                    entry.id = Date.now() + '-' + Math.random().toString(36).substring(2, 9);
                    needsSave = true;
                }
            });
            if (needsSave) {
                localStorage.setItem('wro-2026-history', JSON.stringify(history));
            }
        } catch (e) {
            console.warn('Failed to parse history, resetting');
            localStorage.removeItem('wro-2026-history');
            history = [];
        }
    }

    // Sort by timestamp descending (most recent first)
    history.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

    history.forEach((run, index) => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${index + 1}</td>
            <td>${run.team}</td>
            <td>${run.round}</td>
            <td>${run.score}</td>
            <td>${run.time}</td>
            <td>
                <button class="btn-delete" data-id="${run.id}">Delete</button>
            </td>
        `;
        historyTable.appendChild(row);
    });

    // Add event listeners to delete buttons
    document.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const runId = e.target.dataset.id;
            const index = runHistory.findIndex(r => r.id === runId);
            if (index !== -1 && confirm('Delete this run from history?')) {
                runHistory.splice(index, 1);
                localStorage.setItem('wro-2026-history', JSON.stringify(runHistory));
                loadHistory();
            }
        });
    });
}}